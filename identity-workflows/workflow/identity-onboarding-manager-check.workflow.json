{
  "name": "Shane Cotta Identity Onboarding (manager check)",
  "description": "Hack Day Track 01 stretch: same as Identity Onboarding, but identities without a manager get a 'routing to HR' notice instead of a failed run.",
  "enabled": false,
  "definition": {
    "start": "Wait",
    "steps": {
      "End Step - Success": {
        "actionId": "sp:operator-success",
        "displayName": "",
        "type": "success"
      },
      "Get Identity": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.identity.id",
          "resultSelector": [
            "$.getIdentity.attributes.department",
            "$.getIdentity.attributes.jobTitle",
            "$.getIdentity.attributes.email",
            "$.getIdentity.attributes.displayName",
            "$.getIdentity.attributes.uid",
            "$.getIdentity.attributes.firstname",
            "$.getIdentity.attributes.lastname",
            "$.getIdentity.managerRef.id",
            "$.getIdentity.managerRef.name",
            "$.getIdentity.displayName",
            "$.getIdentity.emailAddress"
          ]
        },
        "displayName": "Get New Hire",
        "nextStep": "Has Manager?",
        "type": "action",
        "versionNumber": 2
      },
      "Get Identity 1": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getIdentity.managerRef.id",
          "resultSelector": [
            "$.getIdentity1.attributes.displayName",
            "$.getIdentity1.attributes.email",
            "$.getIdentity1.displayName",
            "$.getIdentity1.emailAddress"
          ]
        },
        "displayName": "Get Manager",
        "nextStep": "Send Email",
        "type": "action",
        "versionNumber": 2
      },
      "Wait": {
        "actionId": "sp:sleep",
        "attributes": {
          "duration": "1m",
          "type": "waitFor"
        },
        "displayName": "",
        "nextStep": "Get Identity",
        "type": "action",
        "versionNumber": 1
      },
      "Send Email": {
        "actionId": "sp:send-email",
        "attributes": {
          "body": "A new identity has been created in SHF.<br/><br/>Name: {{ $.getIdentity.attributes.displayName }}<br/>Department: {{ $.getIdentity.attributes.department }}<br/>Job title: {{ $.getIdentity.attributes.jobTitle }}<br/>Reports to: {{ $.getIdentity1.attributes.displayName }} ({{ $.getIdentity1.emailAddress }})",
          "context": {},
          "subject": "A new identity {{ $.getIdentity.attributes.displayName }} has been created in SHF",
          "recipientEmailList": [
            "REPLACE_WITH_YOUR_EMAIL@example.com"
          ]
        },
        "displayName": "Send Onboarding Email",
        "nextStep": "End Step - Success",
        "type": "action",
        "versionNumber": 2
      },
      "Has Manager?": {
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Identity 1",
            "variableA.$": "$.getIdentity.managerRef.id"
          }
        ],
        "defaultStep": "Send Email No Manager",
        "displayName": "Has Manager?",
        "type": "choice"
      },
      "Send Email No Manager": {
        "actionId": "sp:send-email",
        "attributes": {
          "body": "A new identity has been created in SHF, but it has no manager on record, routing to HR.<br/><br/>Name: {{ $.getIdentity.attributes.displayName }}<br/>Department: {{ $.getIdentity.attributes.department }}<br/>Job title: {{ $.getIdentity.attributes.jobTitle }}",
          "context": {},
          "subject": "A new identity {{ $.getIdentity.attributes.displayName }} has no manager on record",
          "recipientEmailList": [
            "REPLACE_WITH_YOUR_EMAIL@example.com"
          ]
        },
        "displayName": "Send No-Manager Email",
        "nextStep": "End Step - No Manager",
        "type": "action",
        "versionNumber": 2
      },
      "End Step - No Manager": {
        "actionId": "sp:operator-success",
        "displayName": "",
        "type": "success"
      }
    }
  },
  "trigger": {
    "type": "EVENT",
    "attributes": {
      "id": "idn:identity-created",
      "integrationId": null
    }
  }
}
