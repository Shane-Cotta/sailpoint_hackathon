{
  "name": "Shane Cotta Identity Onboarding (to manager)",
  "description": "Hack Day Track 01 stretch: the onboarding notice goes to the new hire's manager; no manager means no email.",
  "enabled": false,
  "definition": {
    "start": "Wait",
    "steps": {
      "End Step - Success": {
        "actionId": "sp:operator-success",
        "displayName": "",
        "type": "success"
      },
      "Get Identity": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.trigger.identity.id",
          "resultSelector": [
            "$.getIdentity.attributes.department",
            "$.getIdentity.attributes.jobTitle",
            "$.getIdentity.attributes.email",
            "$.getIdentity.attributes.displayName",
            "$.getIdentity.attributes.uid",
            "$.getIdentity.attributes.firstname",
            "$.getIdentity.attributes.lastname",
            "$.getIdentity.managerRef.id",
            "$.getIdentity.managerRef.name",
            "$.getIdentity.displayName",
            "$.getIdentity.emailAddress"
          ]
        },
        "displayName": "Get New Hire",
        "nextStep": "Has Manager?",
        "type": "action",
        "versionNumber": 2
      },
      "Get Identity 1": {
        "actionId": "sp:get-identity",
        "attributes": {
          "id.$": "$.getIdentity.managerRef.id",
          "resultSelector": [
            "$.getIdentity1.attributes.displayName",
            "$.getIdentity1.attributes.email",
            "$.getIdentity1.displayName",
            "$.getIdentity1.emailAddress"
          ]
        },
        "displayName": "Get Manager",
        "nextStep": "Send Email",
        "type": "action",
        "versionNumber": 2
      },
      "Wait": {
        "actionId": "sp:sleep",
        "attributes": {
          "duration": "1m",
          "type": "waitFor"
        },
        "displayName": "",
        "nextStep": "Get Identity",
        "type": "action",
        "versionNumber": 1
      },
      "Send Email": {
        "actionId": "sp:send-email",
        "attributes": {
          "body": "Hi {{ $.getIdentity1.attributes.displayName }},<br/><br/>{{ $.getIdentity.attributes.displayName }} has just been created in SHF and reports to you.<br/><br/>Department: {{ $.getIdentity.attributes.department }}<br/>Job title: {{ $.getIdentity.attributes.jobTitle }}<br/><br/>Please review the access they are given in their first week.",
          "context": {},
          "subject": "Your new report {{ $.getIdentity.attributes.displayName }} starts in SHF",
          "recipientEmailList.$": "$.getIdentity1.emailAddress"
        },
        "displayName": "Email Manager",
        "nextStep": "End Step - Success",
        "type": "action",
        "versionNumber": 2
      },
      "Has Manager?": {
        "choiceList": [
          {
            "comparator": "IsPresent",
            "nextStep": "Get Identity 1",
            "variableA.$": "$.getIdentity.managerRef.id"
          }
        ],
        "defaultStep": "End Step - No Manager",
        "displayName": "Has Manager?",
        "type": "choice"
      },
      "End Step - No Manager": {
        "actionId": "sp:operator-success",
        "displayName": "",
        "type": "success"
      }
    }
  },
  "trigger": {
    "type": "EVENT",
    "attributes": {
      "id": "idn:identity-created",
      "integrationId": null
    }
  }
}
