# Copy this file to `.env` and fill in your tenant's values.
# Create a Personal Access Token in Identity Security Cloud:
#   Admin -> Global Settings -> Personal Access Tokens -> New Token
#
# These are the same variable names the SailPoint Python SDK reads natively.

SAIL_BASE_URL=https://your-tenant.api.identitynow.com
SAIL_CLIENT_ID=your_personal_access_token_client_id
SAIL_CLIENT_SECRET=your_personal_access_token_client_secret

# Optional -- enables the notify_manager tool. The 'Flagged Report to Manager'
# workflow (identity-workflows/workflow/flagged-report-to-manager.workflow.json)
# and its external-trigger OAuth client (POST /workflows/{id}/external/oauth-clients).
# SAIL_FLAGGED_WORKFLOW_ID=
# SAIL_FLAGGED_WORKFLOW_CLIENT_ID=
# SAIL_FLAGGED_WORKFLOW_CLIENT_SECRET=
