{
    "version": 1,
    "manifest": {
        "alias": "manager-lookup-shcotta",
        "name": {
            "en": "Team Access Radar"
        },
        "description": {
            "en": "For managers: see who on your team holds risky or unusual access compared with their peers, and which reviews are open. Same rules as the Team Access Review MCP server."
        },
        "apiScopes": [
            "sp:scopes:all"
        ],
        "permissionPolicy": {},
        "iframeAllow": {},
        "contentSecurityPolicies": {},
        "slots": [
            {
                "slotId": "full-page"
            }
        ],
        "state": "ENABLED"
    },
    "build": {
        "outDir": "./dist/manager-lookup-shcotta/browser",
        "port": 4200
    }
}
